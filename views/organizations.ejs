<%- include('partials/header', { title: title }) %>

<main class="organization-page">

<h1><%= title %></h1>

<p class="organization-intro">
    Learn more about the organization I support, its structure,
    mission, and main activities.
</p>

<section class="organization-images">

    <article class="organization-card">

        <img src="/images/organization-1.jpg" alt="Organization building">

        <h2>Organization</h2>

        <p>
            Learn about the organization, its mission,
            and its role in the community.
        </p>

    </article>

    <article class="organization-card">

        <img src="/images/organization-2.jpg" alt="Organization structure">

        <h2>Structure</h2>

        <p>
            Learn about the organization's structure
            and its main departments.
        </p>

    </article>

    <article class="organization-card">

        <img src="/images/organization-3.jpg" alt="Organization activities">

        <h2>Activities</h2>

        <p>
            Learn about some of the main activities
            and services provided by the organization.
        </p>

    </article>

</section>


</main>

<%- include('partials/footer') %>
