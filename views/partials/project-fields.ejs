<label for="name">Project name</label>
<input type="text" id="name" name="name"
       value="<%= values.name || '' %>" required maxlength="150">

<label for="description">Description</label>
<textarea id="description" name="description" rows="4"
          required maxlength="500"><%= values.description || '' %></textarea>

<label for="location">Location</label>
<input type="text" id="location" name="location"
       value="<%= values.location || '' %>" required maxlength="150">

<label for="organization_id">Organization</label>
<select id="organization_id" name="organization_id" required>
  <option value="">Choose an organization</option>
  <% organizations.forEach(function(org) { %>
    <option value="<%= org.organization_id %>"
      <%= String(values.organization_id) === String(org.organization_id) ? 'selected' : '' %>>
      <%= org.name %>
    </option>
  <% }); %>
</select>