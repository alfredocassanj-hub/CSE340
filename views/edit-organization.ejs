<%- include('partials/header', { title: title }) %>

<main>
  <h1><%= title %></h1>

  <% if (errors.length) { %>
    <div class="form-errors" role="alert">
      <p>Please fix the following errors:</p>
      <ul>
        <% errors.forEach(function(e) { %>
          <li><%= e.msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/edit-organization/<%= organizationId %>" method="POST" class="form">
    <%- include('partials/organization-fields', { values: values }) %>

    <label for="logo_filename">Logo file name</label>
    <input type="text" id="logo_filename" name="logo_filename"
           value="<%= values.logo_filename || '' %>"
           required maxlength="255"
           aria-describedby="logo-help">
    <p id="logo-help" class="help">Name of a file in public/images, e.g. logo.png</p>

    <button type="submit" class="btn">Save changes</button>
    <a href="/organization/<%= organizationId %>" class="btn btn-secondary">Cancel</a>
  </form>
</main>

<%- include('partials/footer') %>