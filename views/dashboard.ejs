<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>

    <p>Name: <%= name %></p>
    <p>Email: <%= email %></p>

    <% if (role_id === 2) { %>
        <p>
            <a href="/users">Manage Users</a>
        </p>
    <% } %>

    <section>
        <h2>My Volunteer Projects</h2>

        <% if (volunteerProjects && volunteerProjects.length > 0) { %>

            <ul>
                <% volunteerProjects.forEach(project => { %>
                    <li>
                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.name %>
                            </a>
                        </h3>

                        <p><%= project.description %></p>
                        <p>Location: <%= project.location %></p>

                        <a
                            href="/remove-volunteer/<%= project.project_id %>"
                            class="btn btn-secondary"
                        >
                            Remove volunteer
                        </a>
                    </li>
                <% }) %>
            </ul>

        <% } else { %>

            <p>You are not volunteering for any projects yet.</p>

        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
