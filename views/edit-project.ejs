<%- include('partials/header', { title: title }) %>

<main>
  <h1><%= title %></h1>

  <% if (errors.length) { %>
    <div class="form-errors" role="alert">
      <p>Please fix the following errors:</p>
      <ul>
        <% errors.forEach(function(e) { %>
          <li><%= e.msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/edit-project/<%= projectId %>" method="POST" class="form">
    <%- include('partials/project-fields', { values: values, organizations: organizations }) %>

    <button type="submit" class="btn">Save changes</button>
    <a href="/project/<%= projectId %>" class="btn btn-secondary">Cancel</a>
  </form>
</main>

<%- include('partials/footer') %>