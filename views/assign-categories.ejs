<%- include('partials/header', { title: title }) %>

<main>
  <h1><%= title %></h1>
  <p class="intro">Project: <strong><%= project.name %></strong></p>

  <form action="/assign-categories/<%= project.project_id %>" method="POST" class="form">
    <fieldset class="checkbox-list">
      <legend>Categories</legend>
      <% categories.forEach(function(category) { %>
        <label class="checkbox-item">
          <input type="checkbox" name="categoryIds"
                 value="<%= category.category_id %>"
                 <%= assignedIds.includes(category.category_id) ? 'checked' : '' %>>
          <%= category.name %>
        </label>
      <% }); %>
    </fieldset>

    <button type="submit" class="btn">Save categories</button>
    <a href="/project/<%= project.project_id %>" class="btn btn-secondary">Cancel</a>
  </form>
</main>

<%- include('partials/footer') %>